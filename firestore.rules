rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user belongs to the target tenant
    function isTenant(tid) {
      return request.auth != null && (
        request.auth.token.tenantId == tid || 
        (request.auth.token.get('email', '').lower() == 'monitor@saegrp.com' && tid == '7jlg4IA2G6lvDJ0S5Vbp')
      );
    }

    // Helper function for global admins
    function isSuperAdmin() {
      return request.auth != null && (request.auth.token.role == 'super_admin' || request.auth.token.role == 'system_owner');
    }

    // Helper function for business owners
    function isBusinessOwner(tid) {
      return isTenant(tid) && request.auth.token.role == 'business_owner';
    }

    match /{document=**} {
      allow read, write: if false; 
    }

    // ============================================
    // COLLECTION GROUP RULES
    // ============================================
    match /{path=**}/tasks/{taskId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || 
        (resource != null && (
          request.auth.uid in resource.data.get('assignedStaffIds', []) || 
          resource.data.get('effectiveUserId', '') == request.auth.uid ||
          resource.data.get('tenantId', '') == request.auth.token.tenantId
        ))
      );
    }
    
    match /{path=**}/qr_stickers/{stickerId} {
      allow read: if true;
    }
    
    // ============================================
    // TV PAIRINGS (Ephemeral)
    // ============================================
    match /tv_pairings/{pin} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null;
      allow delete: if true;
    }

    // ============================================
    // V2 ARCHITECTURE - NEW PLATFORM LOGS
    // ============================================
    match /platform_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if isSuperAdmin();
      allow update, delete: if false; // Immutable
    }
    
    // ============================================
    // V1 ARCHITECTURE - ROOT COLLECTIONS
    // ============================================
    match /logs/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /daily_logs/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /meetings/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /announcements/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /report_configs/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /generated_reports/{docId} {
      allow read: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }
    match /feedback/{docId} {
      allow read, update: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if (request.resource.data.tenantId == 'GLOBAL') || isTenant(request.resource.data.tenantId) || isSuperAdmin();
      // Allow delete if author OR if admin/manager/business_owner within the same tenant
      allow delete: if (isTenant(resource.data.tenantId) && request.auth.uid == resource.data.authorId) 
                    || (isTenant(resource.data.tenantId) && request.auth.token.role in ['admin', 'manager', 'business_owner']) 
                    || isSuperAdmin();
    }
    match /feedback_reports/{docId} {
      // Anyone can submit feedback/bug reports
      allow create: if true;
      allow read: if isSuperAdmin() || isTenant(resource.data.tenantId);
      allow update: if isSuperAdmin() || (
        isTenant(resource.data.tenantId) &&
        isTenant(request.resource.data.tenantId)
      );
      // Allow delete if super admin OR if admin/manager/business_owner within the same tenant
      allow delete: if isSuperAdmin() || (
        isTenant(resource.data.tenantId) &&
        request.auth.token.role in ['admin', 'manager', 'business_owner']
      );
    }
    match /feedback/{docId}/comments/{commentId} {
      allow read, write: if isTenant(get(/databases/$(database)/documents/feedback/$(docId)).data.tenantId) || isSuperAdmin();
    }
    match /features/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
    match /auditLogs/{docId} {
      allow read: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if request.auth != null; 
      // Allow self-updates to gracefully handle Firebase SDK offline-retries of the identical payload
      allow update: if request.auth != null && resource.data.actorUid == request.auth.uid;
      allow delete: if false; 
    }
    match /changelogs/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /system_registry/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
    match /qbwc_queue/{docId} {
      allow read: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }
    match /business_canvases/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /business_facility_maps/{tenantId} {
      allow read, write: if isTenant(tenantId) || isSuperAdmin();
    }
    match /business_zones/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId || 
        isSuperAdmin() || 
        request.auth.token.get('email', '').lower() == 'p.losey@saegrp.com'
      );
    }
    match /user_fcm_tokens/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }
    
    // New Collections Enabled For Realtime Frontend Mirroring
    match /messages/{docId} {
      allow read: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
      allow update, delete: if (isTenant(resource.data.tenantId) && request.auth.uid == resource.data.senderId) || isSuperAdmin();
    }
    match /tasks/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /task_templates/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /jobs/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /career_applications/{docId} {
      // Anyone can submit an application, but only tenant admins can read/manage them
      allow create: if true;
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
    }
    match /vehicles/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /customers/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /inventory/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /inventory_items/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /areas/{docId} {
      allow read, update, delete: if isTenant(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenant(request.resource.data.tenantId) || isSuperAdmin();
    }
    match /user_fcm_tokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isSuperAdmin();
    }
    
    // ============================================
    // ROOT TENANT COLLECTIONS (V2 COMPLIANT)
    // ============================================
    match /businesses/{tenantId} {
      allow read: if isTenant(tenantId) || isSuperAdmin();
      allow write: if isBusinessOwner(tenantId) || isSuperAdmin() || request.auth.token.get('email', '').lower() == 'p.losey@saegrp.com';
      
      // V2 AUDIT LOGS (Tenant Scoped)
      match /audit_logs/{logId} {
        allow create: if isTenant(tenantId);
        allow read: if isTenant(tenantId) && request.auth.token.role == 'admin';
        allow update, delete: if false; 
      }
      
      match /meetings/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /weekly_meetings/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /staff/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /staff_dashboard_configs/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /staff_logs/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /staff_direct_messages/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /dashboard_questions/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /departments/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /canvases/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /time_logs/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /time_sessions/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /time_edit_requests/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /time_off_requests/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /task_time_logs/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /deliveries/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /business_events/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_items/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_customers/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_jobs/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_accounts/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_vendors/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_employees/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_estimates/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_invoices/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_purchase_orders/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_bills/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qb_time_tracking/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /customers/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /jobs/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
        match /tasks/{taskId} {
          allow read, write: if isTenant(tenantId) || isSuperAdmin();
        }
        match /chat_messages/{messageId} {
          allow read, write: if isTenant(tenantId) || isSuperAdmin();
        }
        match /activity/{activityId} {
          allow read, write: if isTenant(tenantId) || isSuperAdmin();
        }
        match /takeoffs/{takeoffId} {
          allow read, write: if isTenant(tenantId) || isSuperAdmin();
        }
      }
      match /inventory_items/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /zones/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /zone_assignments/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /facility_maps/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /canvases/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /audit_logs/{docId} {
        allow read: if isTenant(tenantId) || isSuperAdmin();
        allow create: if request.auth != null;
      }
      match /tasks/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /native_tasks/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /task_defaults/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /vendors/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /services/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /todos/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /messages/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /announcements/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /vehicles/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /shipments/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /parts_requests/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin() || request.auth != null;
      }
      match /activity_feed/{docId} {
        allow read: if isTenant(tenantId) || isSuperAdmin();
        allow write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /package_intake/{docId} {
        allow read, write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qr_stickers/{docId} {
        allow read: if true;
        allow write: if isTenant(tenantId) || isSuperAdmin();
      }
      match /qr_scans/{docId} {
        allow create: if true;
        allow read: if isTenant(tenantId) || isSuperAdmin();
        allow update, delete: if false;
      }
    }
  }
}
